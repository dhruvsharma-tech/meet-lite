PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL — get free DB from https://neon.tech
DATABASE_URL="postgresql://username:password@ep-xyz.neon.tech/neondb?sslmode=require"

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Google OAuth (optional — for Step 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# LiveKit (optional — for Step 10)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-app.livekit.cloud

# Cloudinary (optional — for Step 5)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NODE_ENV=development
